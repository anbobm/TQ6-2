@page
@model Flugmanagementsystem.Web.Pages.Fluege.IndexModel

@{
    ViewData["Title"] = "Flüge";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Flüge</h1>
        <p class="text-muted mb-0">
            Verfügbare Flüge unserer Airline
        </p>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Flugnummer</th>
                        <th>Strecke</th>
                        <th>Abflug</th>
                        <th>Ankunft</th>
                        <th>Preis</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var flug in Model.Fluege)
                    {
                        <tr>
                            <td>@flug.Flugnummer</td>
                            <td>@flug.Abflugort → @flug.Zielort</td>
                            <td>@flug.Abflugzeit.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@flug.Ankunftszeit.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@flug.Preis.ToString("0.00") €</td>
                            <td>
                                @if (flug.Status == "Storniert")
                                {
                                    <span class="badge text-bg-secondary">
                                        @flug.Status
                                    </span>
                                }
                                else if (flug.Status == "Verspätet")
                                {
                                    <span class="badge text-bg-warning">
                                        @flug.Status
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">
                                        @flug.Status
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                @if (flug.Status != "Storniert")
                                {
                                    <a asp-page="/Fluege/Details"
                                       asp-route-id="@flug.FlugId"
                                       class="btn btn-sm btn-outline-primary">
                                        Details
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Nicht buchbar
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
