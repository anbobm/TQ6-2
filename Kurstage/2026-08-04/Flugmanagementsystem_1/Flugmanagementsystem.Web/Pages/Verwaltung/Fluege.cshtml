@page
@model Flugmanagementsystem.Web.Pages.Verwaltung.FluegeModel

@{
    ViewData["Title"] = "Flüge verwalten";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Flüge verwalten</h1>
        <p class="text-muted mb-0">Mitarbeiterbereich</p>
    </div>

    <a asp-page="/Verwaltung/FlugErstellen" class="btn btn-primary">
        Neuen Flug anlegen
    </a>
</div>

@if (TempData["Fehlermeldung"] is string fehlermeldung)
{
    <div class="alert alert-warning">
        @fehlermeldung
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Flugnummer</th>
                        <th>Strecke</th>
                        <th>Abflug</th>
                        <th>Ankunft</th>
                        <th>Sitzplätze</th>
                        <th>Preis</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var flug in Model.Fluege)
                    {
                        <tr>
                            <td>@flug.Flugnummer</td>
                            <td>@flug.Abflugort → @flug.Zielort</td>
                            <td>@flug.Abflugzeit.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@flug.Ankunftszeit.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@flug.AnzahlSitzplaetze</td>
                            <td>@flug.Preis.ToString("0.00") €</td>
                            <td>
                                @if (flug.Status == "Storniert")
                                {
                                    <span class="badge text-bg-secondary">
                                        @flug.Status
                                    </span>
                                }
                                else if (flug.Status == "Verspätet")
                                {
                                    <span class="badge text-bg-warning">
                                        @flug.Status
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">
                                        @flug.Status
                                    </span>
                                }
                            </td>

                            <td class="text-end">
                                @if (flug.Status != "Storniert")
                                {
                                    <a asp-page="/Verwaltung/FlugBearbeiten"
                                       asp-route-id="@flug.FlugId"
                                       class="btn btn-sm btn-outline-primary">
                                        Bearbeiten
                                    </a>

                                    <form method="post"
                                          asp-page-handler="StatusAendern"
                                          asp-route-id="@flug.FlugId"
                                          class="d-inline">
                                        <select name="status"
                                                class="form-select form-select-sm d-inline-block w-auto">
                                            <option value="Geplant"
                                                    selected="@(flug.Status == "Geplant" ? "selected" : null)">
                                                Geplant
                                            </option>
                                            <option value="Verspätet"
                                                    selected="@(flug.Status == "Verspätet" ? "selected" : null)">
                                                Verspätet
                                            </option>
                                        </select>
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-warning">
                                            Status speichern
                                        </button>
                                    </form>

                                    <form method="post"
                                          asp-page-handler="Stornieren"
                                          asp-route-id="@flug.FlugId"
                                          class="d-inline">
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Flug stornieren
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
