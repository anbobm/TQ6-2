@page
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Document</title>
</head>
<body>
    <h1>Hallo!</h1>
    @* Expressions (implizit) *@
    <p>Jetzt: @DateTime.Now</p>

    @* Expressions (explizit) *@
    <p>In 7 Stunden: @(DateTime.Now + TimeSpan.FromHours(7))</p>

    @* Code-Blöcke *@
    @{
        var zahl = 3;
        var zahl2 = 4;
        var summe = zahl + zahl2;
        string ausgabe;
        string[] foo = ["abc", "foo", "bar"];

        if (summe > 7) {
            ausgabe = "Summe ist größer als 7";
        }
        else {
            ausgabe = "Summe ist nicht größer als 7";
        }
        
        // Man kann auch von Code-Block zu HTML übergehen:
        <p>@ausgabe</p>

        for (int i = 0; i <= 9; i++) {
            <p>Aktuell: @i</p>
        }
    }

    @* Für bestimmte Kontrollstrukturen (if, foreach, etc.) kann man Codeblöcke verkürzt schreiben  *@

    @if (true)
    {
        // ...
    }

</body>
</html>