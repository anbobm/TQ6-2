@page
@model BiboApp.Pages.BuchHinzufügenModel
@{
    ViewData["Title"] = "Buch hinzufügen";
}

<form method="post">
    <p>
        Titel:
        <input type="text" name="titel" required  />
    </p>

    <p>
    Autor:
    <select name="autorId">
        @foreach (var autor in Model.Autoren)
        {
            <option value="@autor.Id">@autor.Name</option>
        }
    </select>
</p>

    <input type="submit" value="Buch hinzufügen" />
</form>