@page
@model BiboApp.Pages.BücherModel
@{
    ViewData["Title"] = "Bücher";
}

<a asp-page="/BuchHinzufügen">Buch hinzufügen</a>

<h1>Alle Bücher:</h1>

@foreach (var buch in Model.Bücher)
{
    <p>
        <a asp-page="/BuchDetail" asp-route-id="@buch.Id">
            @buch.Autor.Name - @buch.Titel
        </a>
    </p>
}