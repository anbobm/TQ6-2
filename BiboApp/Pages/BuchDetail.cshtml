@page
@model BuchDetailModel

@if(Model.Buch != null) {
    <h1>@Model.Buch.Titel</h1>

    <p>Autor: @Model.Buch.Autor.Name</p>

    <h2>Rubriken</h2>

    <ul>
        @foreach(var rubrik in Model.Buch.Rubriken) {
            <li>@rubrik.Name</li>
        }
    </ul>

    <h2>Rubrik zuweisen</h2>

    @foreach (var rubrik in Model.Rubriken) {
        <form asp-page="/RubrikZuweisen" method="post">
            <input type="hidden" name="buchid" value="@Model.Buch.Id">
            <input type="hidden" name="rubrikid" value="@rubrik.Id">
            <input type="submit" value="@rubrik.Name" />
        </form>
    }

    <h2>Exemplare</h2>
    @if(Model.Buch.Exemplare.Count > 0)
    {
    <ul>
        @foreach(var exemplar in Model.Buch.Exemplare)
        {
            <li>
                @exemplar.Id - 
                @(exemplar.IstAusgeliehen ? "ausgeliehen" : "verfügbar")
            </li>
        }
    </ul>
    }
    else
    {
        <p>keine Exemplare vorhanden</p>
    }
}
else {
    <p>Buch nicht gefunden</p>
}